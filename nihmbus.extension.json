{
  "manifestVersion": 1,
  "name": "popcraft",
  "displayName": "PopCraft",
  "version": "0.1.0",
  "publisher": "nihmbus",
  "description": "Design graphics, motion and video in PopCraft from Nihmbus: agents work in your own PopCraft editor, on the web or the desktop app, through the Nihmbus plugin.",
  "homepage": "https://github.com/nihmbus/nihmbus-popcraft",
  "license": "MIT",
  "icon": "🎨",
  "engines": {
    "nihmbus": ">=1.3.0"
  },
  "permissions": ["device"],
  "device": {
    "label": "PopCraft",
    "description": "Your PopCraft editor (popcraft.app or the desktop app) with the Nihmbus plugin running.",
    "pairingHint": "In PopCraft, install the Nihmbus plugin, click the Nihmbus icon in the right-hand rail, and enter the code. The icon turns into the coloured Nihmbus mark once connected.",
    "protocol": 1,
    "maxUploadBytes": 524288000,
    "uploadContentTypes": ["image/png", "image/jpeg", "image/webp", "image/svg+xml", "application/pdf"],
    "tools": [
      {
        "name": "status",
        "description": "What is open in the user's PopCraft editor: the current page, the pages of the file, and the selection. Call this first to get node and page ids.",
        "inputSchema": {
          "type": "object",
          "properties": {}
        },
        "mutating": false,
        "timeoutMs": 30000
      },
      {
        "name": "call",
        "description": "Run PopCraft plugin API methods in the user's open PopCraft file, e.g. { method: \"createNode\", args: [\"FRAME\", { name: \"Poster\", width: 1080, height: 1080 }] } or { method: \"setKeyframes\", args: [{ … }] }. `args` are the method's positional arguments exactly as in the PopCraft plugin API reference (https://popcraft.app/docs/plugins/api-reference): read it before calling. Pass `calls` instead to run up to 50 in order in one round trip (stops at the first error). Returns each method's result.",
        "inputSchema": {
          "type": "object",
          "properties": {
            "method": {
              "type": "string",
              "enum": [
                "getSelection",
                "getNode",
                "findNodes",
                "getCurrentPage",
                "getDocumentOutline",
                "measureNodes",
                "getStyles",
                "getVariables",
                "getAnimation",
                "getCompositions",
                "getSequence",
                "getStateMachine",
                "getRecords",
                "getPresentationAudio",
                "getPresentationMix",
                "createNode",
                "createPage",
                "createImage",
                "createComponent",
                "createInstance",
                "createPaintStyle",
                "createComposition",
                "createMotionComponent",
                "updateNode",
                "deleteNode",
                "duplicateNodes",
                "renameNodes",
                "moveNodes",
                "resizeNodes",
                "rotateNodes",
                "flipNodes",
                "reorderNodes",
                "reparentNodes",
                "groupNodes",
                "ungroupNodes",
                "alignNodes",
                "distributeNodes",
                "booleanOperation",
                "flattenNodes",
                "outlineStroke",
                "shapeBuilder",
                "importSvg",
                "setSelection",
                "setCurrentPage",
                "renamePage",
                "setPageSetup",
                "setLocked",
                "setVisible",
                "setMask",
                "setMaskType",
                "setAutoLayout",
                "setFills",
                "setStrokes",
                "setEffects",
                "setShaderFill",
                "replaceColor",
                "applyStyle",
                "setVariableValue",
                "setText",
                "setTypography",
                "setTextFit",
                "setTextPath",
                "flowTextIntoShape",
                "detachText",
                "editTextAnimation",
                "setTimeline",
                "setKeyframes",
                "editBehaviours",
                "applyMotionPreset",
                "staggerMotion",
                "setLayerTiming",
                "setInstancePlayback",
                "editComposition",
                "editSequence",
                "editVideoClip",
                "editFrameAudio",
                "detectAudioOnsets",
                "cutToBeat",
                "edit3DScene",
                "editStateMachine",
                "editPrototype",
                "editComponentProperty",
                "editCollection",
                "editRecords",
                "setRecord",
                "bindField",
                "setRepeat",
                "setRoute",
                "setSemantics",
                "setControl",
                "setShowAdvance",
                "setPresentationTiming",
                "setPresentationAudioSettings",
                "removePresentationAudioClip",
                "usePresentationFallbackAudio"
              ],
              "description": "A PopCraft plugin API method."
            },
            "args": {
              "type": "array",
              "maxItems": 8
            },
            "calls": {
              "type": "array",
              "minItems": 1,
              "maxItems": 50,
              "items": {
                "type": "object",
                "properties": {
                  "method": {
                    "type": "string",
                    "enum": [
                      "getSelection",
                      "getNode",
                      "findNodes",
                      "getCurrentPage",
                      "getDocumentOutline",
                      "measureNodes",
                      "getStyles",
                      "getVariables",
                      "getAnimation",
                      "getCompositions",
                      "getSequence",
                      "getStateMachine",
                      "getRecords",
                      "getPresentationAudio",
                      "getPresentationMix",
                      "createNode",
                      "createPage",
                      "createImage",
                      "createComponent",
                      "createInstance",
                      "createPaintStyle",
                      "createComposition",
                      "createMotionComponent",
                      "updateNode",
                      "deleteNode",
                      "duplicateNodes",
                      "renameNodes",
                      "moveNodes",
                      "resizeNodes",
                      "rotateNodes",
                      "flipNodes",
                      "reorderNodes",
                      "reparentNodes",
                      "groupNodes",
                      "ungroupNodes",
                      "alignNodes",
                      "distributeNodes",
                      "booleanOperation",
                      "flattenNodes",
                      "outlineStroke",
                      "shapeBuilder",
                      "importSvg",
                      "setSelection",
                      "setCurrentPage",
                      "renamePage",
                      "setPageSetup",
                      "setLocked",
                      "setVisible",
                      "setMask",
                      "setMaskType",
                      "setAutoLayout",
                      "setFills",
                      "setStrokes",
                      "setEffects",
                      "setShaderFill",
                      "replaceColor",
                      "applyStyle",
                      "setVariableValue",
                      "setText",
                      "setTypography",
                      "setTextFit",
                      "setTextPath",
                      "flowTextIntoShape",
                      "detachText",
                      "editTextAnimation",
                      "setTimeline",
                      "setKeyframes",
                      "editBehaviours",
                      "applyMotionPreset",
                      "staggerMotion",
                      "setLayerTiming",
                      "setInstancePlayback",
                      "editComposition",
                      "editSequence",
                      "editVideoClip",
                      "editFrameAudio",
                      "detectAudioOnsets",
                      "cutToBeat",
                      "edit3DScene",
                      "editStateMachine",
                      "editPrototype",
                      "editComponentProperty",
                      "editCollection",
                      "editRecords",
                      "setRecord",
                      "bindField",
                      "setRepeat",
                      "setRoute",
                      "setSemantics",
                      "setControl",
                      "setShowAdvance",
                      "setPresentationTiming",
                      "setPresentationAudioSettings",
                      "removePresentationAudioClip",
                      "usePresentationFallbackAudio"
                    ],
                    "description": "A PopCraft plugin API method."
                  },
                  "args": {
                    "type": "array",
                    "maxItems": 8
                  }
                },
                "required": ["method"],
                "additionalProperties": false
              }
            }
          },
          "additionalProperties": false
        },
        "mutating": true,
        "timeoutMs": 300000
      },
      {
        "name": "export",
        "description": "Export one layer (usually a frame) from the user's open PopCraft file as PNG, JPG, WEBP, SVG or PDF, and return a URL to the file. Video (MP4/GIF) is not available through the plugin yet.",
        "inputSchema": {
          "type": "object",
          "properties": {
            "nodeId": {
              "type": "string",
              "description": "The layer to export (from status or call)."
            },
            "format": {
              "type": "string",
              "enum": ["PNG", "JPG", "WEBP", "SVG", "PDF"],
              "default": "PNG"
            },
            "scale": {
              "type": "number",
              "minimum": 0.1,
              "maximum": 8,
              "default": 1
            },
            "filename": {
              "type": "string",
              "maxLength": 100,
              "description": "Without the extension; defaults to the layer's name."
            }
          },
          "required": ["nodeId"],
          "additionalProperties": false
        },
        "mutating": false,
        "timeoutMs": 600000
      }
    ]
  },
  "skills": [
    {
      "path": "skills/popcraft"
    },
    {
      "path": "skills/popcraft-graphics"
    },
    {
      "path": "skills/popcraft-motion"
    },
    {
      "path": "skills/popcraft-video"
    },
    {
      "path": "skills/popcraft-social"
    }
  ]
}
